# Reproducible runtime for the unmodified official BlinkMimic recipe.
# The image contains the pinned code and dependencies. Motion data stays in a
# separately mounted read-only directory so the same image can run locally or
# on a temporary GPU node.
FROM nvcr.io/nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace/blinkmimic/src

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl ffmpeg git python3.10 python3.10-venv \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf https://astral.sh/uv/install.sh | sh \
    && install -m 0755 /root/.local/bin/uv /usr/local/bin/uv

WORKDIR /workspace/blinkmimic
COPY pyproject.toml uv.lock README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
COPY tools ./tools
COPY scripts ./scripts

RUN uv sync --frozen --python /usr/bin/python3.10 --no-dev

ENTRYPOINT ["/bin/bash"]
